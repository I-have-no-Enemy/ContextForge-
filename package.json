{
  "name": "contextforge-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ContextForge — Unified MCP Tools & AI Skills Governance Registry Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=backend",
    "test:coverage": "npm run test:coverage --workspace=backend",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "db:seed": "npm run seed --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "mcp",
    "ai-skills",
    "registry",
    "express",
    "prisma",
    "react",
    "tailwind"
  ],
  "author": "Tawan (KMITL IT)",
  "license": "ISC"
}
