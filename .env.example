# ==============================================================================
# ContextForge Environment Configuration (.env.example)
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Authentication & Secrets
JWT_SECRET=contextforge_super_secure_jwt_dev_secret_key_2026_change_in_prod
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# Database Options (PostgreSQL 16+)
# ------------------------------------------------------------------------------
# Option 1: Local Docker Compose (Default for local development)
DATABASE_URL="postgresql://contextforge:contextforge_secret_2026@localhost:5432/contextforge_db?schema=public"

# Option 2: Cloud Managed Database (e.g. Neon Serverless PostgreSQL / Supabase)
# DATABASE_URL="postgresql://user:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/contextforge?sslmode=require"

# Optional: GitHub Personal Access Token (for background star sync worker)
# GITHUB_PAT=""
